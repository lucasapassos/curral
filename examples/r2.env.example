# Copy to .env.r2 (git-ignored) and fill in. Never commit the real file.
export R2_CATALOG_URI="https://catalog.cloudflarestorage.com/<account_id>/<bucket>"
export R2_WAREHOUSE="<account_id>_<bucket>"
export R2_TOKEN="<cloudflare-api-token>"
# Namespace used for unqualified table names
export R2_SCHEMA="<namespace>"
# Storage prefix the tables live under (shown by EXPLAIN ANALYZE "Filename(s)")
export R2_ALLOWED_PATH="s3://<bucket>/"
# A table to probe, as namespace.table
export R2_TEST_TABLE="<namespace>.<table>"
