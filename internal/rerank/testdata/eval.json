    "revenue": {"header": {"title": "Monthly revenue", "description": "Gross revenue per month", "used_for": ["finance reports"]}, "context": {"schemas": ["sales.main"], "tables": ["sales.main.orders"], "body": "Revenue is sum(orders.amount) grouped by date_trunc('month', created_at). Cancelled orders (status = 'cancelled') must be excluded.", "sqls": [{"sql": "SELECT date_trunc('month', created_at) m, sum(amount) FROM sales.main.orders WHERE status <> 'cancelled' GROUP BY 1", "description": "revenue per month"}]}},
